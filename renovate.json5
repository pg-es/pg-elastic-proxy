{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    ":dependencyDashboard",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
  ],

  timezone: "Asia/Dubai",
  schedule: ["before 6am on saturday"],
  prConcurrentLimit: 10,
  prHourlyLimit: 4,

  packageRules: [
    {
      description: "Automerge patch updates",
      matchUpdateTypes: ["patch"],
      automerge: true,
    },
    {
      description: "Automerge digest and pin updates",
      matchUpdateTypes: ["digest", "pin"],
      automerge: true,
      automergeType: "branch",
    },
  ],
}
